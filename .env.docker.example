# HTTP SERVER
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=9504
# If you use nginx, then provide here name of client header. for example x-real-ip or x-forwarded-for
REAL_IP_HEADER=

TELEGRAM_CLIENT_ADDRESS=api
TELEGRAM_CLIENT_PORT=9503
TELEGRAM_CLIENT_USERNAME=
TELEGRAM_CLIENT_PASSWORD=

SELF_URL=http://127.0.0.1:9504

# SYSTEM
TIMEZONE=UTC
MEMORY_LIMIT=128M

# ACCESS CONTROL

# Symfony sliding window per IP or authenticated username, over 60 seconds.
# Feed and media quotas are separate. Changes take effect after restart.
# -1 disables the quota, 0 denies access, a positive value limits requests/minute.
RPM=15
MEDIA_RPM=50

# Allowed number of errors per minute
# Examples:
#   -1 - allow any number of errors
#   0 - ban after first error
#   2 - allow 2 errors per minute: ban on 3rd error.
ERRORS_LIMIT=0;
MEDIA_ERRORS_LIMIT=2;

# Json list of IP addresses and Basic Auth usernames with custom RPM and errors limits.
# Its a WHITELIST and a BLACKLIST at same time.
# Override rpm, media_rpm, errors_limit and media_errors_limit per client.
# Basic Auth usernames require a "password" value and use the same limits format.
# Example:
#   {
#       \"127.0.0.1\": {\"rpm\":-1, \"errors_limit\":-1},
#       \"1.1.1.1\": {\"rpm\":0, \"media_rpm\":1, \"errors_limit\":0, \"media_errors_limit\":2},
#       \"8.8.8.8\": {\"rpm\":0, \"errors_limit\":0},
#       \"rss-user\": {\"password\":\"change-me\", \"rpm\":60, \"media_rpm\":120, \"errors_limit\":2, \"media_errors_limit\":5}
#   }
CLIENTS_SETTINGS="{
    \"127.0.0.1\": {\"rpm\":-1, \"errors_limit\":-1}
}"

# Set to 0 if you need to output any channels, chats, etc.
# Warnign! All client chats will be vissible to users.
# Make sure to protect this server from internet requests, if you disable this option.
ONLY_PUBLIC_CHANNELS=1

# Regex to disable some channels/users.
# Example: "(username1|username2|user.*name)"
# Leave blanc to disable
FORBIDDEN_PEER_REGEX=""
# If peer resolutions fails with following errors - cache it and dont check this peer again.
# Leave blanc to disable cache
CACHE_PEER_ERRORS_REGEX="CHANNEL_PRIVATE|USERNAME_INVALID|This is not a public channel|This peer is not present in the internal peer database"

# Forbid to view images from webpages
FORBIDDEN_REFERERS_REGEX=""

IP_BLACKLIST=ip_blacklist.csv

# Shared compressed peer data for RSS/JSON and media.
# Set to 0 to disable caching. FLOOD_WAIT cooldowns remain active.
CACHE_ENABLED=1
# Maximum cached peers (channels, groups, dialogs); least recently used peers are evicted together.
CACHE_MAX_CHANNELS=100
# Freshness of peer data; 0 disables fresh reuse.
CACHE_TTL_SECONDS=60
# Cleanup interval per peer; reads always enforce TTL.
CACHE_CLEANUP_INTERVAL_SECONDS=60
# Maximum age of stale data for FLOOD_WAIT fallback and media; 0 disables stale reuse.
CACHE_STALE_TTL_SECONDS=900

# LOGS
# LogLevel::DEBUG => 0,
# LogLevel::INFO => 1,
# LogLevel::NOTICE => 2,
# LogLevel::WARNING => 3,
# LogLevel::ERROR => 4,
# LogLevel::CRITICAL => 5,
# LogLevel::ALERT => 6,
# LogLevel::EMERGENCY => 7,
LOGS_LEVEL=2
