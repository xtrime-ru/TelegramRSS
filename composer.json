{
    "name": "xtrime-ru/telegramrss",
    "description": "Fast, simple, async PHP Telegram RSS & JSON server",
    "type": "project",
    "homepage": "https://tg.i-c-a.su/",
    "license": "MIT",
    "keywords": ["telegram", "mtproto", "protocol", "client", "PHP", "amphp", "async", "daemon", "coroutine", "parser", "micro-service", "RSS"],
    "repositories": [
        {
            "type": "github",
            "url": "https://github.com/xtrime-ru/dns"
        }
    ],
    "require": {
        "php": "^8.1.17||^8.2.4",
        "amphp/http-server": "^3",
        "amphp/http-server-router": "^2",
        "amphp/http-client": "^5",
        "amphp/http-server-static-content": ">=2",
        "amphp/file": "^4",
        "amphp/pipeline": "^1",
        "amphp/http": "^2",
        "vlucas/phpdotenv": "^5",
        "ext-json": "*",
        "ext-dom": "*",
        "ext-simplexml": "*",
        "ext-mbstring": "*",
        "ext-pcntl": "*",
        "symfony/rate-limiter": ">=6.4",
        "symfony/cache": ">=6.4",
        "cweagans/composer-patches": "^2.0"
    },
    "suggest": {
        "ext-zstd": "Optional cache compression, version >=0.18"
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "authors": [
        {
            "name": "Alexander Pankratov",
            "email": "alexander@i-c-a.su"
        }
    ],
    "autoload": {
        "psr-4": {
            "TelegramRSS\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TelegramRSS\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": "@composer reinstall amphp/http-server --no-interaction --no-scripts",
        "test": "phpunit"
    },
    "require-dev": {
        "symfony/phpunit-bridge": ">=6.4",
        "phpunit/phpunit": "^13.0",
        "mockery/mockery": "^1.6"
    },
    "config": {
        "allow-plugins": {
            "cweagans/composer-patches": true
        }
    },
    "extra": {
        "patches": {
            "amphp/http-server": [
                {
                    "description": "Expose request cancellation through getCancellation()",
                    "url": "patches/http-server-request-cancellation.patch",
                    "sha256": "9e59a6449b0e53fd57ac127533e16b0b2607dc99e0d5b84145187f2c5a7d8143",
                    "depth": 1
                }
            ]
        }
    }
}
